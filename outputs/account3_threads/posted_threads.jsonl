{"post_id": null, "posted_at": "2026-08-18T11:36:29.393061", "text_file": "outputs/account3_threads/20260818_113620.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6a8443b4b1be2056286377e7", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "上島竜兵さんの妻・広川ひかるさんが、今夜8時からEテレ『ハートネットTV』に出演します。4年前、夫の上島さんを自死で失った深い悲しみが癒えないまま、今度は広川さん自身が乳がんを患うことになりました。\n\n上島さんがいない中、ひとりでがん治療と向き合わなければならなかった広川さん。孤独で過酷な状況の中でも生きることを諦めず、少しずつ自分の人生を取り戻してきたといいます。\n\n番組は「私のリカバリー 竜ちゃん、それでも生きていく 広川ひかる」というタイトルで、きき手にコロッケさん、司会に廣瀬雄大さんを迎え、それからの日々を丁寧に振り返る内容です。大切な人を突然失った悲しみの中でも前を向こうとする姿は、同じように喪失を経験した人や、困難な状況にいる多くの人の心に響くのではないでしょうか。\n\n気になる方はぜひ今夜チェックしてみてください。", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=_2_Prk68DJoQ7kNvwGqR4gl&_nc_oc=Ado_hTyKWyhgq8QD883Bn_ge6uLGrMmaGjhQJKGlRqeInQ3WtdKcnn80HsnroBUw0vs&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQKxza9Pu7DJ1juytJJ-yaiAYwvyfy_mAkvvqYqaLPMaJNZBR6ZuqrFgBvg03iu3X4QK3ZbWbQWVWg&oh=00_AQEyXULnG0sK3WMkdw8Rh_SReoEJ5d5Jmr-c6OsxUoWHNQ&oe=6A8A2A38", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-08-18T11:36:20.653Z", "platformSpecificData": {"__platformUserIdSnapshot": "27975119945504818", "__usernameSnapshot": "iikotobiyori", "publishingStarted": "2026-08-18T11:36:21.259Z", "lastPublishStage": "publishing"}, "status": "published", "publishAttempts": 0, "contentHash": "ba5f53bad7966fa310155a18ea501b6a", "_id": "6a8443b4b1be2056286377e8", "platformPostId": "18019030538876936", "platformPostUrl": "https://www.threads.com/@iikotobiyori/post/DcLhTTXjPNo", "publishedAt": "2026-08-18T11:36:29.135Z"}], "scheduledFor": "2026-08-18T11:36:20.653Z", "timezone": "UTC", "status": "published", "tags": [], "hashtags": [], "mentions": [], "visibility": "public", "crosspostingEnabled": true, "metadata": {"usageCounted": true}, "publishAttempts": 0, "createdAt": "2026-08-18T11:36:20.830Z", "updatedAt": "2026-08-18T11:36:29.235Z", "__v": 0, "publishingClaimedAt": "2026-08-18T11:36:20.916Z"}, "message": "Post published successfully"}}
{"post_id": null, "posted_at": "2026-08-18T11:44:08.810019", "text_file": "outputs/account3_threads/20260818_114358.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6a84457f7feee36edb3470b6", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "上島竜兵さんの妻・広川ひかるさんが、今夜8時からEテレ『ハートネットTV』に出演します。4年前、夫の上島さんを自死で失った深い悲しみと喪失感が覚めやらぬ中、広川さん自身も乳がんを患うことになりました。上島さんがいない中、ひとりでがん治療と向き合うことになったといいます。それでも生きることを諦めず、少しずつ自分の人生を取り戻してきた広川さん。番組は「私のリカバリー 竜ちゃん、それでも生きていく」というタイトルで、回復への歩みを丁寧に振り返る内容です。きき手はコロッケさん、司会は廣瀬雄大さんが務めます。大切な人を突然失い、さらに病と闘いながらも前を向いてきた広川さんの言葉は、同じような悲しみや孤独を抱えている方にとって、きっと大きな支えになるはずです。今夜の放送、ぜひ見てみてください。\n\n#上島竜兵 #広川ひかる #ハートネットTV", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=_2_Prk68DJoQ7kNvwGqR4gl&_nc_oc=Ado_hTyKWyhgq8QD883Bn_ge6uLGrMmaGjhQJKGlRqeInQ3WtdKcnn80HsnroBUw0vs&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQKxza9Pu7DJ1juytJJ-yaiAYwvyfy_mAkvvqYqaLPMaJNZBR6ZuqrFgBvg03iu3X4QK3ZbWbQWVWg&oh=00_AQEyXULnG0sK3WMkdw8Rh_SReoEJ5d5Jmr-c6OsxUoWHNQ&oe=6A8A2A38", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-08-18T11:43:59.648Z", "platformSpecificData": {"__platformUserIdSnapshot": "27975119945504818", "__usernameSnapshot": "iikotobiyori", "publishingStarted": "2026-08-18T11:44:00.654Z", "lastPublishStage": "publishing"}, "status": "published", "publishAttempts": 0, "contentHash": "541c9d59c62ab9b7fe488f3a4e3667fb", "_id": "