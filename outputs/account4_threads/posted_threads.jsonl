{"post_id": null, "posted_at": "2026-08-18T16:49:49.200359", "text_file": "outputs/account4_threads/20260818_164932.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6a848d20fa749b1f37e5eb69", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "友人の誕生日プレゼント、毎年5,000円のものを贈っていたのに、今年もらったのは500円のお菓子でした😅\n「気持ちが大事」なのはわかるけど、こっちは毎年気を遣って選んでたのに、なんか悲しくて。\n思い切って「来年からお互い贈り合うのやめない？」と提案したら、「ケチ」って思われたみたいで、関係がぎこちなくなってしまいました😮‍💨\n金額より気持ちだよ、って言う人、その「気持ち」の差をどう受け止めてる？🤔", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a84492577555aae015291d7", "profileId": "6a8448a1e1f937617fe936f7", "platform": "threads", "displayName": "kusetsuyo.qa", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468800747_1576664136569291_5396750329151857404_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=107&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=P3XYQcIJoUQQ7kNvwHrdumo&_nc_oc=AdrIR9J7ucdgxEpn1YMC_jofSZ1aszOrWGyO31rJRzKY-PvU6WX-fW9tYbQ9rHc_C8M&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQLa8HgQxKj5NpeZv0RU0xxhnMZHvUvMAj4UTEyg-hoMnpJ6iPc710w9y_dPPH46_35Um_Auik6s8Q&oh=00_AQHk87hB1WGZy2vnXUXdtoZfLTmE8sFSmg6QQSKrVSMGBQ&oe=6A8A002D", "username": "kusetsuyo.qa"}, "profileId": "6a8448a1e1f937617fe936f7", "customMedia": [], "scheduledFor": "2026-08-18T16:49:36.010Z", "platformSpecificData": {"__platformUserIdSnapshot": "38955193034079301", "__usernameSnapshot": "kusetsuyo.qa", "publishingStarted": "2026-08-18T16:49:36.966Z", "lastPublishStage": "publishing"}, "status": "published", "publishAttempts": 0, "contentHash": "b43f44472a3a5f4abfbda43083c7c2bd", "_id": "6a848d20fa749b1f37e5eb6a", "platformPostId": "17908738821461854", "platformPostUrl": "https://www.threads.com/@kusetsuyo.qa/post/DcMFKFSjeiu", "publishedAt": "2026-08-18T