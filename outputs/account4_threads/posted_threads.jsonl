{"post_id": null, "posted_at": "2026-08-18T17:44:29.837037", "text_file": "outputs/account4_threads/20260818_174413.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6a8499f3f309ca73505fc45e", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "友人の誕生日に、毎年1万円のプレゼントを贈り続けてたんですが、自分の誕生日にもらったのが毎回500円のお菓子で😅\n「気持ちが大事」って言葉は好きだけど、5年続くとさすがにモヤモヤしてきて。\n思い切って「お互いにプレゼントなしにしない？」と提案したら、「えっ、私の何かが不満だったの？」って逆に傷つけてしまったみたいで…😭\n金額の話をするのって、友情に水を差すことになるのかな。\nそれとも最初から正直に言うべきだった？💭", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a84492577555aae015291d7", "profileId": "6a8448a1e1f937617fe936f7", "platform": "threads", "displayName": "kusetsuyo.qa", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468800747_1576664136569291_5396750329151857404_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=107&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=P3XYQcIJoUQQ7kNvwHrdumo&_nc_oc=AdrIR9J7ucdgxEpn1YMC_jofSZ1aszOrWGyO31rJRzKY-PvU6WX-fW9tYbQ9rHc_C8M&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQLa8HgQxKj5NpeZv0RU0xxhnMZHvUvMAj4UTEyg-hoMnpJ6iPc710w9y_dPPH46_35Um_Auik6s8Q&oh=00_AQHk87hB1WGZy2vnXUXdtoZfLTmE8sFSmg6QQSKrVSMGBQ&oe=6A8A002D", "username": "kusetsuyo.qa"}, "profileId": "6a8448a1e1f937617fe936f7", "customMedia": [], "scheduledFor": "2026-08-18T17:44:18.847Z", "platformSpecificData": {"__platformUserIdSnapshot": "38955193034079301", "__usernameSnapshot": "kusetsuyo.qa", "publishingStarted": "2026-08-18T17:44:19.902Z", "lastPublishStage": "publishing"}, "status": "published", "publishAttempts": 0, "contentHash": "428c88c3048b26f70eafe759712d17a4", "_id": "6a8499f3f309ca73505fc45f", "platformPostId": "18118752514694616", "platformPostUrl": "https://www.threads.com/@kusetsuyo.qa/post/DcMLafxDEJA", "publishedAt": "2