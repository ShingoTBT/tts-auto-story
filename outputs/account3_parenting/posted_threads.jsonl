{"post_id": "17990236482046797", "posted_at": "2026-09-09T00:54:53.524357", "text_file": "outputs/account3_parenting/20260909_005433.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6aa0ae4cd1b823d96bf448f5", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "ママ友のInstagramを見ていたら、子どもの習い事や受験塾の話が毎日のように流れてきて、気づいたらぐったりしていました😮‍💨\n\n「うちの子、〇〇教室に合格した！」「英検〇級受かった！」って、親の喜びなのはわかるんですが、見ているこちらは自分の子と比べてしまって…。\n\n比べたくないのに比べてしまう自分にもモヤモヤします💭\n\n同じグループに入っていると既読スルーも難しいし、かといってミュートにするのも気まずくて。\nみなさん、こういう「見たくないけど見てしまう」投稿ってどう距離を置いてますか…？🥺", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=X_opOv0FLzcQ7kNvwEUqXa5&_nc_oc=AdrGd6mlmFyK4HsDbTfraNB3NmD4SQo5VWZqGdwmKhZiHhFV7fcbyNFtgHd1n96iTHQ&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQKNDtscxajvDcLcFcNmtswLR-UhwjEfegtuWE4EVywVVYbIGdZbV6RDwdEuetJK3N3LsCWx9ME8tA&oh=00_AQJjbs0-AQl9B4pGLl0WHsdgKa1wCvfQtseqRq64nAtykw&oe=6AA56938", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-09-09T00:54:36.749Z", "status": "published", "publishAttempts": 0, "contentHash": "d1d549df1148b6874c94421d151999b2", "_id": "6aa0ae4cd1b823d96bf448f6", "platformPostId": "17990236482046797", "platformPostUrl": "https://www.threads.com/@iikotobiyori/post/DdDBWjfCNwq", "publishedAt": "2026-09-09T00:54:53.087Z"}], "scheduledFor": "2026-09-09T00:54:36.749Z", "timezone": "UTC", "status": "published", "tags": [], "hashta