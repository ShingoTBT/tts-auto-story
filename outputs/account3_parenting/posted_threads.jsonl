{"post_id": "18132359512642730", "posted_at": "2026-09-08T07:36:13.358800", "text_file": "outputs/account3_parenting/20260908_073558.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6a9fbae0d42d122a472589de", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "習い事の体験教室で「うちの子はもう〇〇ができるんですよね〜」って話、なぜかデフォルトで飛んでくるの、あれなんなんでしょう😅\n\nこちらは「楽しそうだから来てみた」くらいの温度感なのに、気づいたらわが子との比較大会に巻き込まれていて、帰り道でひとり遠い目になってしまいました。\n「すごいですね〜！」って言いながら内心ぐるぐるしてるの、きっと私だけじゃないはず💭\n\n習い事って、子どもが楽しめるかどうかが全てだと思ってたんですが、もしかしてそこも戦場なんですか😮‍💨\n\nみなさんは、こういうとき、うまくかわす技ってありますか？", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=X_opOv0FLzcQ7kNvwEUqXa5&_nc_oc=AdrGd6mlmFyK4HsDbTfraNB3NmD4SQo5VWZqGdwmKhZiHhFV7fcbyNFtgHd1n96iTHQ&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQKNDtscxajvDcLcFcNmtswLR-UhwjEfegtuWE4EVywVVYbIGdZbV6RDwdEuetJK3N3LsCWx9ME8tA&oh=00_AQJjbs0-AQl9B4pGLl0WHsdgKa1wCvfQtseqRq64nAtykw&oe=6AA56938", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-09-08T07:36:00.786Z", "status": "published", "publishAttempts": 0, "contentHash": "8a9844180b82f488a50279bd257df680", "_id": "6a9fbae0d42d122a472589df", "platformPostId": "18132359512642730", "platformPostUrl": "https://www.threads.com/@iikotobiyori/post/DdBKfi1Dhss", "publishedAt": "2026-09-08T07:36:13.073Z"}], "scheduledFor": "2026-09-08T07:36:00.786Z", "timezone": "UTC", "status": "published", "tags": [