{"post_id": "17986255157872100", "posted_at": "2026-09-08T00:50:26.042194", "text_file": "outputs/account3_parenting/20260908_005010.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6a9f5bc4be5f09c564d1b8f2", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "時短なのに「もう帰るの？」って言われるの、地味にしんどい😮‍💨\n定時ピッタリに帰るだけなのに、まるで早退みたいな空気になるの、なんで？\n\n育児中は「時短で助かってるよね」って言われるけど、その分お迎えも寝かしつけも全部ワンオペで回してるんだけどな🤔\n仕事のしわ寄せは申し訳ないと思ってるけど、家に帰ってからも仕事は終わってないんだよね。\n\n時短勤務って「ラクしてる」に見えるのかな、やっぱり😭\n職場で理解してもらえてる方、どうやって雰囲気変えましたか？💭", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=X_opOv0FLzcQ7kNvwE4FFwq&_nc_oc=Adr-gR1dEjCOVXma2eThSlN_VUTjsy7VQDizOpAO1F00d2dMmRSJfGLzYfKIp1OxF5I&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQJICW8OhzC8xpfAaSwGZPvTlLH-tKTUuV-oe0g5gJ_2R48qmOgYqG9JKcVNMd882LGzd_pEDx8vGQ&oh=00_AQI8W_tuyUxlMQLAVqS_7K_HecvYbV28OB2DFoOQrH-4Pw&oe=6AA417B8", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-09-08T00:50:12.268Z", "status": "published", "publishAttempts": 0, "contentHash": "3bdf76a4640e09158031a7f0c3c730aa", "_id": "6a9f5bc4be5f09c564d1b8f3", "platformPostId": "17986255157872100", "platformPostUrl": "https://www.threads.com/@iikotobiyori/post/DdAcDPPCHTp", "publishedAt": "2026-09-08T00:50:25.711Z"}], "scheduledFor": "2026-09-08T00:50:12.268Z", "timezone": "UTC", "status": "published", "tags": [], "hashtags": [], "mentions": []