{"post_id": "18141727324601087", "posted_at": "2026-09-08T07:28:25.667544", "text_file": "outputs/account3_parenting/20260908_072809.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6a9fb90c2443a23774f86c01", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "幼稚園の持ち物、「名前は手書きで」って言われたんですけど😅\n印刷したラベルシールじゃダメなんでしょうか。\n\n先生に確認したら「みなさん手書きにしていただいてます」と言われて、それ以上聞けなくなってしまって。\n夜中に30個近いクレヨンに一本ずつ書いてたら、なんで？ってふと思えてきました🤔\n\n手書きじゃないといけない理由って、何かあるんでしょうか。\nこういうルール、「昔からそうだから」で続いてるだけな気もして😮‍💨\n\nみなさんの園や学校にも、理由がよくわからないルールってありますか💭", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=X_opOv0FLzcQ7kNvwEUqXa5&_nc_oc=AdrGd6mlmFyK4HsDbTfraNB3NmD4SQo5VWZqGdwmKhZiHhFV7fcbyNFtgHd1n96iTHQ&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQKNDtscxajvDcLcFcNmtswLR-UhwjEfegtuWE4EVywVVYbIGdZbV6RDwdEuetJK3N3LsCWx9ME8tA&oh=00_AQJjbs0-AQl9B4pGLl0WHsdgKa1wCvfQtseqRq64nAtykw&oe=6AA56938", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-09-08T07:28:12.683Z", "status": "published", "publishAttempts": 0, "contentHash": "e965b91243b44c5d00d869d28c827afc", "_id": "6a9fb90c2443a23774f86c02", "platformPostId": "18141727324601087", "platformPostUrl": "https://www.threads.com/@iikotobiyori/post/DdBJmY2jo7y", "publishedAt": "2026-09-08T07:28:25.351Z"}], "scheduledFor": "2026-09-08T07:28:12.683Z", "timezone": "UTC", "status": "published", "tags": [], "hashtags": [