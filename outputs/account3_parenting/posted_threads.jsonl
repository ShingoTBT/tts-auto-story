{"post_id": "18003426038989423", "posted_at": "2026-09-09T05:35:55.941958", "text_file": "outputs/account3_parenting/20260909_053544.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6aa0f03343253aa81e15382b", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "SNSを開くたびに「〇〇ちゃん、もう自転車乗れた！」「うちは3歳から英語始めたよ」って流れてくる😮‍💨\n毎回何となくスクロールを止めてしまう自分がいます。\n\n別に競ってるわけじゃないのに、気づいたら「うちの子まだできないな…」ってモヤモヤしてしまって。\n投稿してる側は悪気ゼロなのがまた複雑で💭\n\n「成長記録として残したいだけ」なのはわかってる。\nでも見る側のメンタルってなかなか追いつかないんですよね😅\n\nみなさんはSNSの育児投稿、どう付き合ってますか？\n思い切ってミュートにしてる派ですか、それともうまく流せてる派？🥺", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=X_opOv0FLzcQ7kNvwE8kzUX&_nc_oc=Adpa-rf6VSeERlQGxUX7T41g_uwxfboAF6XXGF-SJUGNQHaghAnoU6IZFDD4MtX-0_o&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQIAKN3rNePqMgULXDSlFQa1MOEPMjKBs79EnTG3yquy2DJ_bVjRxd6pdtTaUDQrzRmzb2FTaxp06Q&oh=00_AQKLtLG1EsopZzvTJrYMbrYC5JAEvN1zPCnJT7MDRmH6bg&oe=6AA6BAB8", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-09-09T05:35:47.261Z", "status": "published", "publishAttempts": 0, "contentHash": "bcbcc464bef3702313092a0734ecbdd4", "_id": "6aa0f03343253aa81e15382c", "platformPostId": "18003426038989423", "platformPostUrl": "https://www.threads.com/@iikotobiyori/post/DdDhhzRFw3l", "publishedAt": "2026-09-09T05:35:55.610Z"}], "scheduledFor": "2026-09-09T05:35:47.261Z", "timezone": "UTC", "status": "published", "tag