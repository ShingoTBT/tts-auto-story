{"post_id": "18090190961185639", "posted_at": "2026-09-09T10:27:52.883378", "text_file": "outputs/account3_parenting/20260909_102739.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6aa1349eafd267cd56b43f3d", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "園のグループLINE、最近ちょっと居心地が悪くて😅\n\n誰かが「うちの子、〇〇教室に入れることにした」と書くと、次々と「うちも体験行ってみようかな」「あそこ評判いいよね」ってレスが続いて、気づけば習い事情報交換会になってる。\n参加しないと乗り遅れた気になるし、返信しても「うちはまだ何もしてないんですよね…」って書きづらくて💭\n\n別に習わせたくないわけじゃないけど、タイミングとかお金の都合とか、それぞれ事情があるじゃないですか😮‍💨\n\nみなさんはグループLINEの「習い事トーク」、どう付き合ってますか？\n流してる？それともちゃんと参加してる🥺", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=X_opOv0FLzcQ7kNvwE8kzUX&_nc_oc=Adpa-rf6VSeERlQGxUX7T41g_uwxfboAF6XXGF-SJUGNQHaghAnoU6IZFDD4MtX-0_o&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQIAKN3rNePqMgULXDSlFQa1MOEPMjKBs79EnTG3yquy2DJ_bVjRxd6pdtTaUDQrzRmzb2FTaxp06Q&oh=00_AQKLtLG1EsopZzvTJrYMbrYC5JAEvN1zPCnJT7MDRmH6bg&oe=6AA6BAB8", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-09-09T10:27:41.905Z", "status": "published", "publishAttempts": 0, "contentHash": "7995c2c053f3d4393669767176468d6f", "_id": "6aa1349eafd267cd56b43f3e", "platformPostId": "18090190961185639", "platformPostUrl": "https://www.threads.com/@iikotobiyori/post/DdEC73dkX-P", "publishedAt": "2026-09-09T10:27:52.583Z"}], "scheduledFor": "2026-09-09T10:27:41.905Z", "timezone": "UTC", "status": "published", "tags": [], "hashtags": [], "mentions": [], "visibility": "public", "crosspostingEnabled": true, "metadata": {"usageCounted": true}, "publishAttempts": 0, "createdAt": "2026-09-09T10:27:42.043Z", "updatedAt": "2026-09-09T10:27:52.685Z", "__v": 0, "publishingClaimedAt": "2026-09-09T10:27:42.107Z"}, "message": "Post published successfully"}}
