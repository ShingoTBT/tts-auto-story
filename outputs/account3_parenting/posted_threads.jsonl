{"post_id": "17944135800071912", "posted_at": "2026-09-08T19:42:20.028797", "text_file": "outputs/account3_parenting/20260908_194200.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6aa0650a225dcdee72023595", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "ママ友のインスタ、見るたびに心がざわつく...😮‍💨\n「うちの子、もう漢字書けるようになったよ〜」ってストーリー、正直しんどい。\n\n我が子がマイペースなのは分かってる。\nでも毎日流れてくる「○○できた！」報告を見ていると、気づけば比べてしまってる自分がいて🥺\n\n比べても意味ないって頭では分かってるのに、夜子どもが寝た後にスマホ開くのが怖くなってきた😭\nインスタをミュートしたら少し楽になったけど、それはそれで「輪から外れてる気がする」っていう謎の焦りも出てきて...。\n\nSNS、うまく距離の取り方ってみんなどうしてるんだろう💭\nもうフォローやめた、って人もいる？", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=X_opOv0FLzcQ7kNvwEUqXa5&_nc_oc=AdrGd6mlmFyK4HsDbTfraNB3NmD4SQo5VWZqGdwmKhZiHhFV7fcbyNFtgHd1n96iTHQ&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQKNDtscxajvDcLcFcNmtswLR-UhwjEfegtuWE4EVywVVYbIGdZbV6RDwdEuetJK3N3LsCWx9ME8tA&oh=00_AQJjbs0-AQl9B4pGLl0WHsdgKa1wCvfQtseqRq64nAtykw&oe=6AA56938", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-09-08T19:42:02.503Z", "status": "published", "publishAttempts": 0, "contentHash": "17d480b3fdd78391ecdb41d2d6cceb49", "_id": "6aa0650a225dcdee72023596", "platformPostId": "17944135800071912", "platformPostUrl": "https://www.threads.com/@iikotobiyori/post/DdCdlMDAqB6", "publishedAt": "2026-09-08T19:42:19.735Z"}], "scheduledFor": "2026-09-08T19:42:02.503Z", "timezone": "UTC", "status": "published", "tags": [], "hashtags": [], "mentions": [], "visibility": "public", "crosspostingEnabled": true, "metadata": {"usageCounted": true}, "publishAttempts": 0, "createdAt": "2026-09-08T19:42:02.913Z", "updatedAt": "2026-09-08T19:42:19.839Z", "__v": 0, "publishingClaimedAt": "2026-09-08T19:42:02.986Z"}, "message": "Post published successfully"}}
{"post_id": "17879113002534342", "posted_at": "2026-09-08T22:12:32.036132", "text_file": "outputs/account3_parenting/20260908_221213.txt", "commented": false, "raw_result": {"post": {"recycling": {"enabled": false, "gapFreq": "month", "recycleCount": 0, "contentVariations": [], "contentVariationIndex": 0}, "_id": "6aa088423dd5ecbc96bc254e", "userId": "6a843db67c8c976bfff300ea", "title": "", "content": "SNSを開くたびに、育児アカウントでの投稿ラッシュが流れてきて、地味に疲れてきました😮‍💨\n「〇ヶ月でひらがな全部読めるようになった！」「英語もペラペラで天才かも」みたいな投稿、否定したいわけじゃないんですが…。\nうちの子と比べてしまう自分がいて、モヤモヤが止まらないんです💭\n我が子のペースでいい、ってわかってるのに、どうしてこんなに引っ張られてしまうんだろう。\nみなさんはSNSの育児投稿、どう向き合ってますか？ミュートや距離感、何かコツがあれば教えてほしいです🥺", "mediaItems": [], "platforms": [{"platform": "threads", "accountId": {"_id": "6a843e5477555aae01456e57", "profileId": "6a843dc47c8c976bfff30285", "platform": "threads", "displayName": "iikotobiyori", "isActive": true, "profilePicture": "https://scontent-lhr11-1.cdninstagram.com/v/t51.2885-19/468314590_8453537411410202_5430368323558972174_n.jpg?stp=dst-jpg_s206x206_tt6&_nc_cat=101&ccb=7-5&_nc_sid=30ff31&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy41NjUuQzMifQ%3D%3D&_nc_ohc=X_opOv0FLzcQ7kNvwEUqXa5&_nc_oc=AdrGd6mlmFyK4HsDbTfraNB3NmD4SQo5VWZqGdwmKhZiHhFV7fcbyNFtgHd1n96iTHQ&_nc_zt=24&_nc_ht=scontent-lhr11-1.cdninstagram.com&edm=AP4hL3IEAAAA&_nc_tpa=Q5bMBQKNDtscxajvDcLcFcNmtswLR-UhwjEfegtuWE4EVywVVYbIGdZbV6RDwdEuetJK3N3LsCWx9ME8tA&oh=00_AQJjbs0-AQl9B4pGLl0WHsdgKa1wCvfQtseqRq64nAtykw&oe=6AA56938", "username": "iikotobiyori"}, "profileId": "6a843dc47c8c976bfff30285", "customMedia": [], "scheduledFor": "2026-09-08T22:12:17.951Z", "status": "published", "publishAttempts": 0, "contentHash": "dbebf460102e26a3221d0ad458df1c4e", "_id": "6aa088423dd5ecbc96bc254f", "platformPostId": "17879113002534342", "platformPostUrl": "https://www.threads.com/@iikotobiyori/post/DdCuxkliCXs", "publishedAt": "2026-09-08T22:12:31.706Z"}], "scheduledFor": "2026-09-08T22:12:17.951Z", "timezone": "UTC", "status": "published", "tags": [], "hashtags": [], "mentions"